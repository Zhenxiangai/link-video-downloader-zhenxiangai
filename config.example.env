# Archive data stays outside this skill directory.
WECHAT_ARCHIVE_ROOT="$HOME/Documents/WeChatArchive"

# Reuse the Python managed by Hermes.
WECHAT_PYTHON="${HERMES_HOME:-$HOME/.hermes}/hermes-agent/venv/bin/python"
WECHAT_FFMPEG="ffmpeg"
WECHAT_WHISPER_CLI="whisper-cli"
WECHAT_WHISPER_MODEL="$WECHAT_ARCHIVE_ROOT/models/ggml-small.bin"

# Required only for manual commands that create or modify archive jobs.
WECHAT_ARCHIVE_ENABLED="1"
